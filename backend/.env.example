# ==============================================================================
# Kestral AI — Production Environment Configuration (.env.example)
# ==============================================================================

# Database Settings (PostgreSQL + psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kestral_db
TEST_DATABASE_URL=sqlite:///./test_kestral.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & JWT Configuration
# Generate a secure 32+ byte key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Roots (Relative to backend/ or absolute path)
STORAGE_ROOT=.
MAX_UPLOAD_SIZE_BYTES=524288000

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOADS_PER_MINUTE=30
RATE_LIMIT_EXPORTS_PER_MINUTE=20

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,https://localhost:3000,http://127.0.0.1:3000

# Initial Bootstrap Administrator (Created if not exists on startup)
FIRST_SUPERUSER_EMAIL=admin@kestral.ai
FIRST_SUPERUSER_PASSWORD=Admin123!SecurePassword
FIRST_SUPERUSER_NAME=System Administrator
